<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.ourtv.home" android:versionCode="5" android:versionName="1.3">
    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="30" />
    <!-- Weather, and the family phone page on the home network. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Continue Watching rows that apps share with the TV. -->
    <uses-permission android:name="android.permission.READ_TV_LISTINGS" />
    <!-- Granted once over adb (pm grant): lets the app switch its own helper back on if Android dropped it. -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" />
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <queries>
        <package android:name="com.google.android.apps.tv.launcherx" />
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>
    <application android:label="@string/app_name" android:banner="@drawable/banner" android:icon="@drawable/banner"
        android:allowBackup="false" android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen">
        <activity android:name=".MainActivity" android:exported="true" android:launchMode="singleTask"
            android:screenOrientation="landscape"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- directBootAware: TCL's Android 11 otherwise switches the helper off after a restart. -->
        <service android:name=".Helper" android:label="@string/helper_name" android:exported="true"
            android:directBootAware="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data android:name="android.accessibilityservice" android:resource="@xml/helper" />
        </service>
        <!-- Only used to read what Spotify is playing; it never reads notifications. -->
        <service android:name=".Listener" android:label="@string/app_name" android:exported="true"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>
</manifest>
